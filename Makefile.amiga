# Cross build using the same SDL/MiniGL ABI as OpenLara.
AMIGA_ROOT ?= /opt/amiga16-copy
DEV_ROOT ?= /mnt/d/dev
MGL_SDK ?= $(DEV_ROOT)/Pistorm3D/MiniGL_Classic_v29.1/libraryroot
SDL_ROOT ?= $(DEV_ROOT)/Pistorm3D/tests/sdl-fullscreen-fallback
SDL_BASE_LIB ?= $(SDL_ROOT)/build-fs/libSDL_libnix-fs.a
SDL_LIB := build-amiga-v29/libSDL-v29.a
MGL_IMPORT := build-amiga-v29/libminigl-v29.a
MIXER_ROOT := amiga/vendor/SDL_mixer
CC := $(AMIGA_ROOT)/bin/m68k-amigaos-gcc
TARGET := build-amiga-v29/Doom64EX-Plus-MiniGL
CPPFLAGS := -DAMIGA_MINIGL -D__LEGACYGL__ -I src/engine -I amiga/include \
 -I$(MGL_SDK)/include -I$(SDL_ROOT)/include -I$(DEV_ROOT)/Pistorm3D/libSDL12-mgl/include \
 -I$(MIXER_ROOT) -I$(SDL_ROOT)/include/SDL -DWAV_MUSIC
CFLAGS := -std=gnu99 -O2 -m68060 -mhard-float -noixemul -fbbb=- \
 -fno-strict-aliasing -fomit-frame-pointer -ffunction-sections -fdata-sections -MMD -MP
LDFLAGS := -m68060 -mhard-float -noixemul -Wl,--gc-sections -Wl,-u,_KPrintF
LDLIBS := -Wl,--start-group build-amiga-v29/libSDL_mixer.a $(SDL_LIB) \
 $(MGL_IMPORT) -lpng -lz -lm -ldebug -Wl,--end-group
OBJS := $(addprefix build-amiga-v29/, i_system.o am_draw.o am_map.o info.o md5.o tables.o con_console.o con_cvar.o d_devstat.o d_main.o d_net.o f_finale.o in_stuff.o g_actions.o g_demo.o g_game.o g_settings.o wi_stuff.o m_cheat.o m_menu.o m_misc.o m_fixed.o m_keys.o m_password.o m_random.o m_shift.o net_client.o net_common.o net_io.o net_loop.o net_packet.o net_query.o net_server.o net_structure.o dgl.o gl_draw.o gl_main.o gl_texture.o sc_main.o p_ceilng.o p_doors.o p_enemy.o p_user.o p_floor.o p_inter.o p_lights.o p_macros.o p_map.o p_maputl.o p_mobj.o p_plats.o p_pspr.o p_saveg.o p_setup.o p_sight.o p_spec.o p_switch.o p_telept.o p_tick.o r_clipper.o r_drawlist.o r_lights.o r_main.o r_scene.o r_bsp.o r_sky.o r_things.o r_wipe.o s_sound.o st_stuff.o i_audio_amiga.o amiga_music.o i_main.o i_png.o i_video_amiga.o amiga_mouse.o amiga_gl.o w_file.o w_merge.o w_wad.o z_zone.o i_sdlinput.o  sha1.o)
.PHONY: all clean check
all: $(TARGET)
$(TARGET): $(OBJS) build-amiga-v29/libSDL_mixer.a $(SDL_LIB) $(MGL_IMPORT)
	$(CC) $(LDFLAGS) $(OBJS) $(LDLIBS) -o $@
build-amiga-v29/%.o: src/engine/%.c Makefile.amiga
	@mkdir -p build-amiga-v29
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
build-amiga-v29/%.o: amiga/%.c Makefile.amiga
	@mkdir -p build-amiga-v29
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
check: $(TARGET)
	file $(TARGET)
	$(AMIGA_ROOT)/bin/m68k-amigaos-nm -u $(TARGET)
clean:
	rm -rf build-amiga-v29
-include $(OBJS:.o=.d)

.PHONY: package
package: check
	python3 amiga/package.py

MIXER_UNITS := mixer music load_aiff load_voc effects_internal effect_position effect_stereoreverse wavestream
MIXER_OBJS := $(addprefix build-amiga-v29/mixer/,$(addsuffix .o,$(MIXER_UNITS)))
build-amiga-v29/mixer/%.o: $(MIXER_ROOT)/%.c Makefile.amiga
	@mkdir -p build-amiga-v29/mixer
	$(CC) $(CPPFLAGS) $(CFLAGS) -c $< -o $@
build-amiga-v29/libSDL_mixer.a: $(MIXER_OBJS)
	$(AMIGA_ROOT)/bin/m68k-amigaos-ar rcs $@ $^
-include $(MIXER_OBJS:.o=.d)

# Rebuild every MiniGL-facing SDL object with the same token ABI as the game.
SDL_GL_OBJS := build-amiga-v29/v29/SDL_cgxvideo.o build-amiga-v29/v29/SDL_cgxgl.o build-amiga-v29/v29/SDL_cgxgl_wrapper.o
MGL_CLIENT_OBJS := build-amiga-v29/v29/minigl_base.o build-amiga-v29/v29/minigl_open.o build-amiga-v29/v29/minigl_dispatch_stub_gcc.o
build-amiga-v29/v29/SDL_%.o: $(SDL_ROOT)/video/amigaos/SDL_%.c Makefile.amiga
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -I$(MGL_SDK)/include -I$(SDL_ROOT)/include -I$(SDL_ROOT)/include/SDL -I$(DEV_ROOT)/Pistorm3D/libSDL12-mgl/include -I$(SDL_ROOT) -I$(SDL_ROOT)/video/amigaos -c $< -o $@
build-amiga-v29/v29/minigl_%.o: $(MGL_SDK)/client/minigl_%.c Makefile.amiga
	@mkdir -p $(@D)
	$(CC) $(CFLAGS) -I$(MGL_SDK)/include -c $< -o $@
build-amiga-v29/v29/minigl_dispatch_stub_gcc.o: $(MGL_SDK)/client/minigl_dispatch_stub_gcc.s Makefile.amiga
	@mkdir -p $(@D)
	$(CC) -m68060 -c $< -o $@
$(MGL_IMPORT): $(MGL_CLIENT_OBJS)
	$(AMIGA_ROOT)/bin/m68k-amigaos-ar rcs $@ $^
$(SDL_LIB): $(SDL_BASE_LIB) $(SDL_GL_OBJS)
	cp $(SDL_BASE_LIB) $@
	$(AMIGA_ROOT)/bin/m68k-amigaos-ar rcs $@ $(SDL_GL_OBJS)
-include $(SDL_GL_OBJS:.o=.d) $(MGL_CLIENT_OBJS:.o=.d)

# Keep the legacy SDL video core on its original GCC 6.5/libnix ABI.
# Its modern MiniGL glue remains built with the application's compiler.
build-amiga-v29/v29/SDL_cgxvideo.o: amiga/vendor/SDL-window/SDL_cgxvideo.c Makefile.amiga
	@mkdir -p $(@D)
	/opt/amiga-gcc65-250215/bin/m68k-amigaos-gcc -std=gnu99 -O2 -m68060 -mhard-float -mcrt=nix20 -fno-strict-aliasing -fno-builtin -MMD -MP -I$(MGL_SDK)/include -I$(SDL_ROOT)/include -I$(SDL_ROOT)/include/SDL -I$(DEV_ROOT)/Pistorm3D/libSDL12-mgl/include -I$(SDL_ROOT) -I$(SDL_ROOT)/video/amigaos -c $< -o $@
